# Copy this file to .env for local development. NEVER commit the real .env file.

PORT=3000
NODE_ENV=development

# AI assistant (Anthropic API). Leave empty to use the built-in FAQ matcher only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=12000

# MongoDB (chat logs + feedback). Example: MongoDB Atlas connection string.
MONGODB_URI=
MONGODB_DB=tunewave

# SQL database (SQLite file). Tickets, FAQs, error codes and the offline catalogue live here.
SQLITE_PATH=./data/tunewave.db

# Protects GET /api/admin/tickets. Use a long random string.
ADMIN_TOKEN=

# Third-party API (iTunes Search) - time limit and fallback settings
EXTERNAL_TIMEOUT_MS=3000
ITUNES_COUNTRY=IN
DISCOVER_DEFAULT_TERM=top hits

# Set to "off" in production if you do not want the demo error routes
DEMO_ROUTES=on
